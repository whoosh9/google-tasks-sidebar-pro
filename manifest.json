{
  "manifest_version": 3,
  "name": "Google Tasks Sidebar Pro",
  "version": "1.0",
  "description": "Google Tasks in your browser's side panel, with account selection and customizable themes.",
  "permissions": [
    "sidePanel",
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "https://tasks.google.com/*"
  ],
  "action": {
    "default_title": "Google Tasks",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "google_tasks_embed_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  }
}
